# Server
PORT
NODE_ENV
CORS_ORIGIN

# SMTP — Resend, Gmail App Password, Mailtrap or any SMTP provider
SMTP_HOST
SMTP_PORT
SMTP_SECURE
SMTP_USER
SMTP_PASSWORD

# Sender + owner address (the owner gets all contact submissions)
MAIL_FROM
OWNER_EMAIL

# AI provider — pick one
# OpenAI
OPENAI_API_KEY
OPENAI_MODEL

# (or Anthropic) — code uses OpenAI SDK by default; swap in src/chat/chat.service.ts
# ANTHROPIC_API_KEY=sk-ant-xxx
